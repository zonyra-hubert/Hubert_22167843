# Copied to .env automatically when the Codespace is created. Never commit .env.
# Keys are NOT stored here: they come from your Codespaces secrets
# (GROQ_API_KEY and GEMINI_API_KEY), which appear as environment variables.
# See the Free Model Access Guide.

# Main model for the code labs (Groq free tier), called through LiteLLM
LLM_MODEL=groq/openai/gpt-oss-20b

# Backup model (Google AI Studio free tier). Use it when Groq is unavailable or
# you have used today's free requests: comment out the line above and uncomment this one.
# LLM_MODEL=gemini/gemini-3.5-flash-lite

# Model names are retired from time to time. If a name stops working, use the one announced in class.
